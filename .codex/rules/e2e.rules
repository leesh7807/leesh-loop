prefix_rule(
    pattern = ["npm", "run", "e2e"],
    decision = "allow",
    justification = "Run the isolated Local Smoke Run with its controlled Worker.",
    match = [
        "npm run e2e",
        "npm run e2e -- --mode interactive",
    ],
    not_match = [
        "npm run start",
        "npm run stop",
    ],
)
