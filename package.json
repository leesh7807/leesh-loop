{
  "name": "leesh-loop",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "leesh-loop": "bin/leesh-loop.mjs"
  },
  "scripts": {
    "start": "node operator/app/leesh-loop.mjs start operator/project.json",
    "start:fast": "node operator/app/leesh-loop.mjs start operator/project.json --skip-external-readiness",
    "stop": "node operator/app/leesh-loop.mjs stop operator/project.json",
    "e2e": "node e2e/cli.mjs run",
    "test": "node --test operator/app/test/init.test.mjs operator/app/test/operator_bootstrap.test.mjs operator/app/test/start_cli.test.mjs"
  }
}
