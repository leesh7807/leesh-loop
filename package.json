{
  "name": "leesh-loop",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "leesh-loop": "bin/leesh-loop.mjs"
  },
  "scripts": {
    "start": "node operator/app/leesh-loop.mjs start project.toml",
    "start:fast": "node operator/app/leesh-loop.mjs start project.toml --skip-external-readiness",
    "stop": "node operator/app/leesh-loop.mjs stop project.toml",
    "local-e2e": "node local-e2e/cli.mjs run",
    "publish-local-plan": "node operator/app/publish-local-plan.mjs project.toml",
    "test": "node --test operator/app/test/*.test.mjs operator/local_task_store/test/*.test.mjs operator/ui/test/*.test.js"
  }
}
