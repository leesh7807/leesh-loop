#!/bin/sh
set -eu

usage() {
  printf '%s\n' 'Usage:' '  chatgpt-shot submit "<prompt>"' '  chatgpt-shot jobs <job-id>' >&2
  exit 2
}

case "${1:-}" in
  submit)
    [ "$#" -eq 2 ] || usage
    case "$2" in
      *[![:space:]]*) ;;
      *) usage ;;
    esac
    action=submit
    value=$2
    ;;
  jobs)
    [ "$#" -eq 2 ] || usage
    action=jobs
    value=$2
    ;;
  *)
    usage
    ;;
esac

if [ -n "${CHATGPT_SHOT_WORKER_DISCOVERY_PATH:-}" ]; then
  discovery_path=$CHATGPT_SHOT_WORKER_DISCOVERY_PATH
elif [ -n "${XDG_CACHE_HOME:-}" ]; then
  discovery_path=$XDG_CACHE_HOME/chatgpt-shot/runtime.json
else
  discovery_path=$HOME/.cache/chatgpt-shot/runtime.json
fi

case "$discovery_path" in
  /*) ;;
  *)
    printf '%s\n' 'BROWSER_UNAVAILABLE: chatgpt-shot Service discovery must be an absolute Operator path.' >&2
    exit 1
    ;;
esac

exec node - "$discovery_path" "$action" "$value" <<'NODE'
const fs = require('node:fs');
const http = require('node:http');

const discoveryPath = process.argv[2];
const action = process.argv[3];
const value = process.argv[4];
const jobId = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;

if (action === 'jobs' && !jobId.test(value)) {
  process.stderr.write('CONFIG_INVALID: Usage: chatgpt-shot jobs <job-id>\n');
  process.exit(2);
}

let record;
try {
  record = JSON.parse(fs.readFileSync(discoveryPath, 'utf8'));
} catch {
  process.stderr.write(`BROWSER_UNAVAILABLE: No prepared chatgpt-shot Service discovery at ${discoveryPath}.\n`);
  process.exit(1);
}

if (record?.host !== '127.0.0.1' || !Number.isInteger(record.port) || record.port < 1 || record.port > 65_535 || typeof record.credential !== 'string' || record.credential.length === 0) {
  process.stderr.write('BROWSER_UNAVAILABLE: Invalid chatgpt-shot Service discovery record.\n');
  process.exit(1);
}

const body = action === 'submit' ? JSON.stringify({ prompt: value }) : undefined;
const path = action === 'submit' ? '/jobs' : `/jobs/${encodeURIComponent(value)}`;
const request = http.request({
  host: record.host,
  port: record.port,
  path,
  method: action === 'submit' ? 'POST' : 'GET',
  headers: {
    authorization: `Bearer ${record.credential}`,
    ...(body ? { 'content-type': 'application/json', 'content-length': Buffer.byteLength(body) } : {})
  }
}, response => {
  let body = '';
  response.setEncoding('utf8');
  response.on('data', chunk => body += chunk);
  response.on('end', () => {
    let payload;
    try {
      payload = JSON.parse(body);
    } catch {
      process.stderr.write('BROWSER_UNAVAILABLE: Prepared chatgpt-shot Service returned invalid JSON.\n');
      process.exitCode = 1;
      return;
    }

    if (response.statusCode !== 200) {
      const code = typeof payload.code === 'string' ? payload.code : 'INVOCATION_FAILED';
      const message = typeof payload.message === 'string' ? payload.message : 'Service request failed.';
      process.stderr.write(`${code}: ${message}\n`);
      process.exitCode = 1;
      return;
    }

    if (action === 'submit') {
      if (typeof payload.id !== 'string' || !jobId.test(payload.id)) {
        process.stderr.write('INVOCATION_FAILED: Prepared chatgpt-shot Service returned no Job ID.\n');
        process.exitCode = 1;
        return;
      }
      process.stdout.write(`${payload.id}\n`);
    } else {
      if (typeof payload.id !== 'string' || typeof payload.state !== 'string' || !Object.prototype.hasOwnProperty.call(payload, 'result') || !Object.prototype.hasOwnProperty.call(payload, 'error')) {
        process.stderr.write('INVOCATION_FAILED: Prepared chatgpt-shot Service returned an invalid Job snapshot.\n');
        process.exitCode = 1;
        return;
      }
      process.stdout.write(`${JSON.stringify(payload)}\n`);
    }
  });
});

request.on('error', error => {
  process.stderr.write(`BROWSER_UNAVAILABLE: Prepared chatgpt-shot Service is unreachable: ${error.message}\n`);
  process.exitCode = 1;
});

if (body) request.end(body); else request.end();
NODE
