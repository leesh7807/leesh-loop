#!/bin/sh
set -eu

usage() {
  cat >&2 <<'USAGE'
Usage: operator/app/operator-bootstrap [--skip-external-readiness] [--] [command [argument ...]]

Validate Operator core readiness, optionally prepare the chatgpt-shot Service,
and execute a command with the worker-facing interface enabled.

The command form is the supported Symphony entry point, for example:
  operator/app/operator-bootstrap -- operator/symphony/bin/symphony --i-understand-that-this-will-be-running-without-the-usual-guardrails
USAGE
  exit 2
}

fail() {
  printf 'Loop setup needs attention: %s\n' "$*" >&2
  exit 1
}

startup_status_file=${SYMPHONY_OPERATOR_STARTUP_STATUS_FILE:-}
report() {
  [ -n "$startup_status_file" ] || return 0
  startup_status_directory=$(dirname -- "$startup_status_file")
  mkdir -p -- "$startup_status_directory" || return 0
  startup_status_temporary="${startup_status_file}.$$.tmp"
  printf '%s\n' "$1" >"$startup_status_temporary" && mv -f -- "$startup_status_temporary" "$startup_status_file"
}

skip_external_readiness=false
if [ "${1:-}" = '--skip-external-readiness' ]; then
  skip_external_readiness=true
  shift
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repository_root=$(CDPATH= cd -- "$script_dir/../.." && pwd -P)

case "${1:-}" in
  -h|--help) usage ;;
esac

report 'checking your workspace and required tools'
workspace_root=${SYMPHONY_WORKSPACE_ROOT:-}
[ -n "$workspace_root" ] || fail 'SYMPHONY_WORKSPACE_ROOT must be set by the Operator.'
case "$workspace_root" in
  /*) ;;
  *) fail "SYMPHONY_WORKSPACE_ROOT must be an absolute path: $workspace_root" ;;
esac

command -v realpath >/dev/null 2>&1 || fail 'this machine is missing a required Unix tool; install the usual Linux utilities and retry.'
workspace_root=$(realpath -m -- "$workspace_root") || fail "cannot resolve workspace root: $workspace_root"
repository_root=$(realpath -e -- "$repository_root") || fail 'cannot resolve the canonical repository root.'

is_under() {
  case "$1/" in
    "$2/"*) return 0 ;;
    *) return 1 ;;
  esac
}

[ "$workspace_root" != "$repository_root" ] || fail 'the worker workspace must use a separate folder from the Leesh Loop repository.'
if is_under "$workspace_root" "$repository_root" && [ "${SYMPHONY_ALLOW_WORKSPACE_ROOT_INSIDE_REPOSITORY:-false}" != true ]; then
  fail "the worker workspace must be outside the Leesh Loop repository: $workspace_root"
fi

mkdir -p -- "$workspace_root" || fail "cannot create workspace root: $workspace_root"
[ -w "$workspace_root" ] || fail "the worker workspace folder is not writable: $workspace_root"

command -v node >/dev/null 2>&1 || fail 'Node.js is not installed or is not on PATH.'
command -v git >/dev/null 2>&1 || fail 'Git is not installed or is not on PATH.'
command -v gh >/dev/null 2>&1 || fail 'GitHub CLI is not installed or is not on PATH.'
command -v curl >/dev/null 2>&1 || fail 'this machine is missing curl; install it and retry.'

if [ "$skip_external_readiness" = false ]; then
  worker_client=$repository_root/operator/external/chatgpt-shot/chatgpt-shot
  [ -x "$worker_client" ] || fail 'the Leesh Loop installation is incomplete; restore its included worker files and retry.'
  command -v chatgpt-shot >/dev/null 2>&1 || fail 'the chatgpt-shot review command is not installed on this machine or is not on PATH.'

  xdg_config_home=${XDG_CONFIG_HOME:-$HOME/.config}
  xdg_data_home=${XDG_DATA_HOME:-$HOME/.local/share}
  xdg_cache_home=${XDG_CACHE_HOME:-$HOME/.cache}
  chatgpt_config_root=$(realpath -m -- "$xdg_config_home/chatgpt-shot")
  chatgpt_data_root=$(realpath -m -- "$xdg_data_home/chatgpt-shot")
  chatgpt_cache_root=$(realpath -m -- "$xdg_cache_home/chatgpt-shot")

  for state_path in "$chatgpt_config_root" "$chatgpt_data_root" "$chatgpt_cache_root"; do
    is_under "$state_path" "$workspace_root" && fail "chatgpt-shot persistent state must be outside the worker workspace: $state_path"
  done

  chatgpt_discovery_path=$chatgpt_cache_root/runtime.json
  worker_interface_root=${SYMPHONY_OPERATOR_INTERFACE_ROOT:-$chatgpt_cache_root/worker-interface}
  case "$worker_interface_root" in
    /*) ;;
    *) fail "SYMPHONY_OPERATOR_INTERFACE_ROOT must be an absolute path: $worker_interface_root" ;;
  esac
  worker_interface_root=$(realpath -m -- "$worker_interface_root")
  is_under "$worker_interface_root" "$workspace_root" && fail 'worker interface must be outside the worker workspace.'
  configured_chatgpt_config_path=$(chatgpt-shot config path 2>/dev/null) || fail 'chatgpt-shot could not resolve its Operator configuration path.'
  chatgpt_config_path=$(realpath -m -- "$configured_chatgpt_config_path")
  [ "$chatgpt_config_path" = "$(realpath -m -- "$chatgpt_config_root/.env")" ] || fail "chatgpt-shot configuration is outside the expected Operator path: $configured_chatgpt_config_path"
  is_under "$chatgpt_config_path" "$workspace_root" && fail 'chatgpt-shot credentials must be outside the worker workspace.'
  chatgpt_browser_profile=$(realpath -m -- "$chatgpt_data_root/chrome-profile")
  chatgpt_lock_path=$(realpath -m -- "$chatgpt_cache_root/service.lock")
  for operator_path in "$chatgpt_browser_profile" "$chatgpt_discovery_path" "$chatgpt_lock_path"; do
    is_under "$operator_path" "$workspace_root" && fail "chatgpt-shot runtime state must be outside the worker workspace: $operator_path"
  done

  chatgpt_config_output=$(chatgpt-shot config show 2>&1) || fail 'chatgpt-shot user configuration is not readable.'
  printf '%s\n' "$chatgpt_config_output" | grep -q '^NOTION_TOKEN: set$' || fail 'chatgpt-shot NOTION_TOKEN is missing.'
  printf '%s\n' "$chatgpt_config_output" | grep -q '^CHATGPT_SHOT_NOTION_DATABASE_URL: set$' || fail 'chatgpt-shot Invocation database URL is missing.'

  for state_path in "$chatgpt_config_root" "$chatgpt_data_root" "$chatgpt_cache_root"; do
    [ -r "$state_path" ] && [ -w "$state_path" ] || fail "Operator-owned chatgpt-shot state is not usable: $state_path"
  done
fi

report 'checking GitHub access'
github_repository_url=${SYMPHONY_GITHUB_REPOSITORY_URL:-}
[ -n "$github_repository_url" ] || fail 'SYMPHONY_GITHUB_REPOSITORY_URL must be configured by the Project.'
github_base_branch=${SYMPHONY_GITHUB_BASE_BRANCH:-}
[ -n "$github_base_branch" ] || fail 'SYMPHONY_GITHUB_BASE_BRANCH must be configured by the Project.'
git_transport=$(node "$repository_root/operator/app/github-repository-url.mjs" "$github_repository_url") ||
  fail 'SYMPHONY_GITHUB_REPOSITORY_URL must be a valid HTTPS or SSH GitHub repository URL.'

curl --fail --silent --show-error --connect-timeout 10 --max-time 30 \
  --output /dev/null https://github.com/ || fail 'GitHub network reachability check failed.'

if ! GH_PROMPT_DISABLED=1 gh auth status --hostname github.com >/dev/null 2>&1; then
  fail 'GitHub CLI is not signed in. Run gh auth login and make sure this account can access the target repository.'
fi

if [ "$git_transport" = https ]; then
  github_helpers=$(git config --global --get-all credential.https://github.com.helper 2>/dev/null || true)
  if ! printf '%s\n' "$github_helpers" | grep -Fq 'gh auth git-credential'; then
    GH_PROMPT_DISABLED=1 gh auth setup-git --hostname github.com >/dev/null 2>&1 ||
      fail 'GitHub CLI could not configure Git access. Run gh auth setup-git, then retry.'
  fi

  credential_response=$(printf '%s\n' 'protocol=https' 'host=github.com' '' | GIT_TERMINAL_PROMPT=0 git credential fill 2>/dev/null) || fail 'Git has no GitHub credential. Sign in with GitHub CLI and configure Git access, then retry.'
  credential_username=$(printf '%s\n' "$credential_response" | sed -n 's/^username=//p' | head -n 1)
  credential_password=$(printf '%s\n' "$credential_response" | sed -n 's/^password=//p' | head -n 1)
  [ -n "$credential_username" ] && [ -n "$credential_password" ] || fail 'Git could not read a complete GitHub credential. Sign in with GitHub CLI and configure Git access, then retry.'

  # A public repository can make ls-remote succeed without GitHub accepting
  # the credential selected by Git. Validate that exact helper output as well.
  if ! GH_HOST=github.com GH_PROMPT_DISABLED=1 GH_TOKEN="$credential_password" gh api user >/dev/null 2>&1; then
    fail 'GitHub rejected the credential Git selected. Sign in again and confirm repository access.'
  fi
  unset credential_response credential_username credential_password github_helpers
fi

GH_PROMPT_DISABLED=1 gh api --hostname github.com user >/dev/null 2>&1 || fail 'GitHub CLI sign-in could not be confirmed. Run gh auth login, then retry.'
GIT_TERMINAL_PROMPT=0 git -c credential.interactive=never ls-remote "$github_repository_url" HEAD >/dev/null 2>&1 || fail 'this account cannot read the configured target repository. Check the repository URL and account access.'

report 'checking the target branch'
github_base_commit=$(node "$repository_root/operator/app/git-target.mjs" "$github_repository_url" "$github_base_branch") ||
  fail 'the configured GitHub base branch could not be prepared. Check github_repository_url and github_base_branch in operator/project.json.'

if [ "$skip_external_readiness" = false ]; then
  report 'checking the review setup'
  if ! chatgpt-shot doctor >/dev/null 2>&1; then
    fail 'the review setup is incomplete. Check chatgpt-shot sign-in and configuration, then retry.'
  fi

service_accepting() {
  node - "$chatgpt_discovery_path" <<'NODE'
const fs = require('node:fs');
const http = require('node:http');

const discoveryPath = process.argv[2];
let record;
try {
  record = JSON.parse(fs.readFileSync(discoveryPath, 'utf8'));
} catch {
  process.exit(1);
}

if (record?.host !== '127.0.0.1' || !Number.isInteger(record.port) || record.port < 1 || record.port > 65_535 || typeof record.credential !== 'string' || record.credential.length === 0) {
  process.exit(1);
}

const request = http.get({
  host: record.host,
  port: record.port,
  path: '/health',
  headers: { authorization: `Bearer ${record.credential}` }
}, response => {
  let body = '';
  response.setEncoding('utf8');
  response.on('data', chunk => body += chunk);
  response.on('end', () => {
    try {
      const status = JSON.parse(body);
      process.exitCode = response.statusCode === 200 &&
        status.pid === record.pid &&
        status.protocolVersion === 1 &&
        status.accepting === true ? 0 : 1;
    } catch {
      process.exitCode = 1;
    }
  });
});

request.setTimeout(10_000, () => request.destroy());
request.on('error', () => { process.exitCode = 1; });
NODE
}

  report 'checking the review service'
  if ! service_accepting; then
  chatgpt-shot start >/dev/null 2>&1 || fail 'the review service could not start. Check its configuration, then retry.'
fi

service_accepting || fail 'the review service is not accepting requests. Check its configuration, then retry.'

report 'checking the review connection'
smoke_prompt=${SYMPHONY_CHATGPT_SHOT_SMOKE_PROMPT:-'Operator readiness smoke check. Reply with exactly READY.'}
smoke_job_id_file=$(mktemp "${TMPDIR:-/tmp}/symphony-chatgpt-shot-smoke-id.XXXXXX")
smoke_snapshot=$(mktemp "${TMPDIR:-/tmp}/symphony-chatgpt-shot-smoke-snapshot.XXXXXX")
trap 'rm -f -- "$smoke_job_id_file" "$smoke_snapshot"' EXIT HUP INT TERM

if ! chatgpt-shot submit "$smoke_prompt" >"$smoke_job_id_file"; then
  fail 'the review connection check could not be sent. Check its credentials and retry.'
fi
[ -s "$smoke_job_id_file" ] || fail 'the review connection check returned no result. Check its configuration and retry.'
smoke_job_id=$(tr -d '[:space:]' <"$smoke_job_id_file")
[ -n "$smoke_job_id" ] || fail 'the review connection check returned no result. Check its configuration and retry.'
while :; do
  if ! chatgpt-shot jobs "$smoke_job_id" >"$smoke_snapshot"; then
    fail 'the review connection check could not be read. Check the review service and retry.'
  fi
  smoke_state=$(node - "$smoke_snapshot" <<'NODE'
const fs = require('node:fs');
const snapshot = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
if (typeof snapshot.state !== 'string' || !Object.prototype.hasOwnProperty.call(snapshot, 'result') || !Object.prototype.hasOwnProperty.call(snapshot, 'error')) process.exit(1);
process.stdout.write(snapshot.state);
NODE
  ) || fail 'the review connection check returned an invalid result. Check the review setup and retry.'
  case "$smoke_state" in
    completed)
      node - "$smoke_snapshot" <<'NODE' || fail 'the review connection check completed without a result. Check the review setup and retry.'
const fs = require('node:fs');
const snapshot = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
if (typeof snapshot.result !== 'string' || snapshot.result.length === 0) process.exit(1);
NODE
      break
      ;;
    failed)
      fail 'the review connection check failed. Check the review service and credentials, then retry.'
      ;;
    pending|in_progress)
      sleep 1
      ;;
    *)
      fail 'the review connection check returned an unexpected status. Check the review setup and retry.'
      ;;
  esac
done
  service_accepting || fail 'the review service stopped responding after the connection check. Check its setup and retry.'
fi

github_base_commit=$(node "$repository_root/operator/app/git-target.mjs" read "$github_repository_url" "$github_base_branch") ||
  fail 'configured base branch readback failed before readiness evidence was recorded.'
if [ "$skip_external_readiness" = false ]; then
  report 'preparing task access'
  mkdir -p -- "$worker_interface_root" || fail "cannot create worker interface directory: $worker_interface_root"
  cp -- "$worker_client" "$worker_interface_root/chatgpt-shot" || fail 'cannot prepare the worker-facing chatgpt-shot interface.'
  chmod 755 -- "$worker_interface_root/chatgpt-shot" || fail 'cannot make the worker-facing chatgpt-shot interface executable.'

  readiness_file=${SYMPHONY_OPERATOR_READINESS_FILE:-$chatgpt_cache_root/operator-readiness.json}
  case "$readiness_file" in
    /*) ;;
    *) fail "SYMPHONY_OPERATOR_READINESS_FILE must be an absolute path: $readiness_file" ;;
  esac
  readiness_file=$(realpath -m -- "$readiness_file")
  is_under "$readiness_file" "$workspace_root" && fail 'Operator readiness state must be outside the worker workspace.'
  readiness_directory=$(dirname -- "$readiness_file")
  mkdir -p -- "$readiness_directory" || fail "cannot create readiness state directory: $readiness_directory"
  chmod 700 -- "$readiness_directory" 2>/dev/null || true

  readiness_tmp=$(mktemp "${readiness_file}.XXXXXX") || fail "cannot create readiness state: $readiness_file"
  trap 'rm -f -- "$smoke_job_id_file" "$smoke_snapshot" "$readiness_tmp"' EXIT HUP INT TERM
  umask 077
  node - "$readiness_tmp" "$workspace_root" "$repository_root" "$github_repository_url" "$github_base_branch" "$github_base_commit" "$chatgpt_discovery_path" "$worker_interface_root" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" <<'NODE' || fail "cannot write readiness state: $readiness_file"
const fs = require('node:fs');

const [, , outputPath, workspaceRoot, repositoryRoot, githubRepositoryUrl, githubBaseBranch, githubBaseCommit, discoveryPath, interfaceRoot, preparedAt] = process.argv;
fs.writeFileSync(outputPath, JSON.stringify({
  workspace_root: workspaceRoot,
  repository_root: repositoryRoot,
  github_repository_url: githubRepositoryUrl,
  github_base_branch: githubBaseBranch,
  github_base_commit: githubBaseCommit,
  chatgpt_shot_discovery_path: discoveryPath,
  worker_interface_root: interfaceRoot,
  prepared_at: preparedAt
}) + '\n');
NODE
  mv -f -- "$readiness_tmp" "$readiness_file" || fail "cannot publish readiness state: $readiness_file"
  chmod 600 -- "$readiness_file" 2>/dev/null || true
  printf 'Loop setup checks passed. Worker workspace: %s. Review command: %s.\n' "$workspace_root" "$chatgpt_discovery_path"
else
  report 'skipping review service checks'
  printf 'Loop setup checks passed. Worker workspace: %s. Review service checks were skipped by configuration.\n' "$workspace_root"
fi

if [ "$#" -eq 0 ]; then
  exit 0
fi

if [ "$1" = "--" ]; then
  shift
fi
[ "$#" -gt 0 ] || usage

if [ "$skip_external_readiness" = false ]; then
  export CHATGPT_SHOT_WORKER_DISCOVERY_PATH=$chatgpt_discovery_path
  export SYMPHONY_OPERATOR_READINESS_FILE=$readiness_file
  export CHATGPT_SHOT_WORKER_INTERFACE_ROOT=$worker_interface_root
fi
report 'starting task processing'
exec "$@"
